{
  "name": "github-actions-demo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cashflow": "bun --filter @demo/cashflow dev",
    "dev:pnl": "bun --filter @demo/pnl dev",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '@demo/*' build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.4.5",
    "typescript": "^5.6.0"
  }
}
